    "    ax.scatter(vendor_data['total_tokens'], vendor_data['total_cost'], \n",
    "              label=vendor, alpha=0.7, s=50)\n",
    "ax.set_title('Token Usage vs Cost by Vendor')\n",
    "ax.set_xlabel('Total Tokens')\n",
    "ax.set_ylabel('Total Cost (USD)')\n",
    "ax.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Model Right-Sizing Analysis\n",
    "\n",
    "Identify opportunities to reduce costs by switching to more cost-effective models."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Model cost comparison\n",
    "model_analysis = decisions_df.groupby(['vendor', 'model']).agg({\n",
    "    'total_cost': ['sum', 'mean'],\n",
    "    'cost_per_decision': 'mean',\n",
    "    'total_tokens': 'mean',\n",
    "    'team': 'count'\n",
    "}).round(6)\n",
    "\n",
    "model_analysis.columns = ['total_spend', 'avg_cost', 'cost_per_decision', 'avg_tokens', 'usage_count']\n",
    "model_analysis = model_analysis.reset_index().sort_values('cost_per_decision', ascending=False)\n",
    "\n",
    "print(\"Model Cost Analysis (by cost per decision):\")\n",
    "print(model_analysis.to_string(index=False))\n",
    "\n",
    "# Right-sizing opportunities\n",
    "print(\"\\nRIGHT-SIZING OPPORTUNITIES:\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# Find GPT-4o usage\n",
    "gpt4o_usage = decisions_df[decisions_df['model'] == 'gpt-4o']\n",
    "if len(gpt4o_usage) > 0:\n",
    "    gpt4o_avg_cost = gpt4o_usage['cost_per_decision'].mean()\n",
    "    gpt4o_teams = gpt4o_usage['team'].unique()\n",
    "    \n",
    "    # Calculate potential savings with GPT-4o-mini\n",
    "    gpt4o_mini_cost = 0.15 / 1_000_000 * gpt4o_usage['input_tokens'].mean() + 0.60 / 1_000_000 * gpt4o_usage['output_tokens'].mean()\n",
    "    savings_per_decision = gpt4o_avg_cost - gpt4o_mini_cost\n",
    "    savings_percentage = (savings_per_decision / gpt4o_avg_cost) * 100\n",
    "    \n",
    "    print(f\"1. GPT-4o → GPT-4o-mini Switch:\")\n",
    "    print(f\"   Current cost per decision: ${gpt4o_avg_cost:.6f}\")\n",
    "    print(f\"   GPT-4o-mini cost per decision: ${gpt4o_mini_cost:.6f}\")\n",
    "    print(f\"   Savings per decision: ${savings_per_decision:.6f} ({savings_percentage:.1f}%)\")\n",
    "    print(f\"   Teams using GPT-4o: {', '.join(gpt4o_teams)}\")\n",
    "    \n",
    "    # Annual savings projection\n",
    "    if 'dynamic-pricing' in gpt4o_teams:\n",
    "        annual_decisions = 500_000 * 365  # 500K decisions/day for dynamic pricing\n",
    "        annual_savings = savings_per_decision * annual_decisions\n",
    "        print(f\"   Annual savings potential: ${annual_savings:,.0f}\")\n",
    "\n",
    "# Find Claude Sonnet usage\n",
    "sonnet_usage = decisions_df[decisions_df['model'] == 'claude-3-5-sonnet']\n",
    "if len(sonnet_usage) > 0:\n",
    "    sonnet_avg_cost = sonnet_usage['cost_per_decision'].mean()\n",
    "    haiku_cost = 0.25 / 1_000_000 * sonnet_usage['input_tokens'].mean() + 1.25 / 1_000_000 * sonnet_usage['output_tokens'].mean()\n",
    "    savings_per_decision = sonnet_avg_cost - haiku_cost\n",
    "    savings_percentage = (savings_per_decision / sonnet_avg_cost) * 100\n",
    "    \n",
    "    print(f\"\\n2. Claude-3.5-Sonnet → Claude-3-Haiku Switch:\")\n",
    "    print(f\"   Current cost per decision: ${sonnet_avg_cost:.6f}\")\n",
    "    print(f\"   Claude-3-Haiku cost per decision: ${haiku_cost:.6f}\")\n",
    "    print(f\"   Savings per decision: ${savings_per_decision:.6f} ({savings_percentage:.1f}%)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Peak Season Cost Impact Analysis\n",
    "\n",
    "Analyze the cost impact of Vantara's Q4 peak season (4.2x multiplier) on AI spending."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Peak season analysis\n",
    "peak_decisions = decisions_df[decisions_df['is_peak_season']]\n",
    "non_peak_decisions = decisions_df[~decisions_df['is_peak_season']]\n",
    "\n",
    "print(\"PEAK SEASON COST IMPACT ANALYSIS:\")\n",
    "print(\"=\" * 50)\n",
    "print(f\"Peak season decisions: {len(peak_decisions)} ({len(peak_decisions)/len(decisions_df)*100:.1f}%)\")\n",
    "print(f\"Non-peak decisions: {len(non_peak_decisions)} ({len(non_peak_decisions)/len(decisions_df)*100:.1f}%)\")\n",
    "\n",
    "if len(peak_decisions) > 0 and len(non_peak_decisions) > 0:\n",
    "    peak_avg_cost = peak_decisions['cost_per_decision'].mean()\n",
    "    non_peak_avg_cost = non_peak_decisions['cost_per_decision'].mean()\n",
    "    cost_multiplier = peak_avg_cost / non_peak_avg_cost if non_peak_avg_cost > 0 else 1\n",
    "    \n",
    "    print(f\"\\nAverage cost per decision:\")\n",
    "    print(f\"  Peak season (Q4): ${peak_avg_cost:.6f}\")\n",
    "    print(f\"  Non-peak: ${non_peak_avg_cost:.6f}\")\n",
    "    print(f\"  Observed multiplier: {cost_multiplier:.2f}x\")\n",
    "    \n",
    "    # Monthly projections\n",
    "    baseline_monthly = 316667  # $3.8M / 12\n",
    "    peak_monthly = baseline_monthly * COMPANY['peak_cost_multiplier']\n",
    "    \n",
    "    print(f\"\\nMonthly spending projections:\")\n",
    "    print(f\"  Baseline month: ${baseline_monthly:,}\")\n",
    "    print(f\"  Peak season month: ${peak_monthly:,}\")\n",
    "    print(f\"  Peak season increase: ${peak_monthly - baseline_monthly:,}\")\n",
    "    \n",
    "    # Annual impact\n",
    "    q4_months = 3\n",
    "    annual_peak_impact = (peak_monthly - baseline_monthly) * q4_months\n",
    "    print(f\"\\nAnnual peak season impact: ${annual_peak_impact:,}\")\n",
    "\n",
    "# Visualize peak vs non-peak costs\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))\n",
    "\n",
    "# Cost distribution comparison\n",
    "if len(peak_decisions) > 0 and len(non_peak_decisions) > 0:\n",
    "    ax1.hist(non_peak_decisions['cost_per_decision'], alpha=0.7, label='Non-Peak', bins=10, color='lightblue')\n",
    "    ax1.hist(peak_decisions['cost_per_decision'], alpha=0.7, label='Peak Season', bins=10, color='orange')\n",
    "    ax1.set_xlabel('Cost per Decision (USD)')\n",
    "    ax1.set_ylabel('Frequency')\n",
    "    ax1.set_title('Cost Distribution: Peak vs Non-Peak')\n",
    "    ax1.legend()\n",
    "\n",
    "# Monthly cost projection\n",
    "months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']\n",
    "baseline = 316667\n",
    "monthly_costs = [baseline] * 9 + [baseline * 4.2] * 3  # Q4 multiplier\n",
    "\n",
    "colors = ['lightblue' if cost == baseline else 'orange' for cost in monthly_costs]\n",
    "ax2.bar(months, monthly_costs, color=colors, alpha=0.7)\n",
    "ax2.set_title('Projected Monthly AI Spending')\n",
    "ax2.set_ylabel('Monthly Cost (USD)')\n",
    "ax2.tick_params(axis='x', rotation=45)\n",
    "\n",
    "# Add cost labels\n",
    "for i, cost in enumerate(monthly_costs):\n",
    "    ax2.annotate(f'${cost/1000:.0f}K', (i, cost), ha='center', va='bottom', fontsize=8)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
