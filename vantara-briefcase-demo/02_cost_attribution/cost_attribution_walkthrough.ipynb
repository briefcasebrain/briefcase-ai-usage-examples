   "source": [
    "## Audit Trail Verification and Cost Reconciliation\n",
    "\n",
    "Verify that all cost calculations are accurate and retrievable from the audit trail."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cost calculation verification\n",
    "print(\"COST CALCULATION VERIFICATION:\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "verification_results = []\n",
    "for i, decision_id in enumerate(stored_ids[:10]):  # Check first 10 decisions\n",
    "    retrieved = backend_instance.load_decision(decision_id)\n",
    "    if retrieved:\n",
    "        # Extract stored values\n",
